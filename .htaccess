# always use https and the bare address (www -> ashrafis.co)
RewriteEngine On
# ON AFTER SSL (remove the # on the next 3 lines)
#RewriteCond %{HTTPS} off [OR]
#RewriteCond %{HTTP_HOST} ^www\. [NC]
#RewriteRule ^ https://ashrafis.co%{REQUEST_URI} [L,R=301]

DirectoryIndex index.html
Options -Indexes

AddType application/manifest+json .webmanifest
AddType image/webp .webp
AddType image/svg+xml .svg

# html always fresh (admin publishes), images and scripts cached for a week
<IfModule mod_headers.c>
  <FilesMatch "\.(html|json|webmanifest)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "\.(webp|png|svg|js|css)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
</IfModule>
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>
