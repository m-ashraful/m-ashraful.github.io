# BEGIN cPanel-generated php ini directives, do not edit
# Manual editing of this file may result in unexpected behavior.
# To make changes to this file, use the cPanel MultiPHP INI Editor (Home >> Software >> MultiPHP INI Editor)
# For more information, read our documentation (https://go.cpanel.net/EA4ModifyINI)
<IfModule php8_module>
   php_value error_log "/home/ashrafis/logs/php.error.log"
   php_flag log_errors On
</IfModule>
<IfModule lsapi_module>
   php_value error_log "/home/ashrafis/logs/php.error.log"
   php_flag log_errors On
</IfModule>
# END cPanel-generated php ini directives, do not edit

# always use https and the bare address (www.x -> x). No domain is written here,
# so the same file works wherever the site is served (now: m.ashrafis.co).
RewriteEngine On
# (certificate renewal checks under /.well-known/ are left alone)
RewriteCond %{REQUEST_URI} !^/\.well-known/
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteCond %{HTTP_HOST} ^(?:www\.)?(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

DirectoryIndex index.html

# hidden files (deploy state, .nojekyll ...) are not for visitors
<FilesMatch "^\.">
  Require all denied
</FilesMatch>
Options -Indexes

AddType application/manifest+json .webmanifest
AddType image/webp .webp
AddType image/svg+xml .svg

# html always fresh (admin publishes), images and scripts cached for a week
<IfModule mod_headers.c>
  <FilesMatch "\.(html|json|webmanifest)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "\.(webp|png|svg|js|css)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
</IfModule>
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>
